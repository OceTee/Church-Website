# ---------------------------------------------------------------------------
# BACKEND environment. Copy to `backend/.env` for `npm run dev` in the backend.
# In production these are Environment Variables on the backend Vercel project.
# NEVER commit a real .env — it is gitignored.
# ---------------------------------------------------------------------------

# --- CORS (required: the frontend is a different origin) ---
# Exact origin(s) of the frontend, comma-separated. No trailing slash.
ALLOWED_ORIGIN=http://localhost:5173

# --- Admin authentication ---
# The admin password is stored in the database as a scrypt hash. ADMIN_PASSWORD
# is only used ONCE, to create the first admin account on an empty database.
# After that, change it from the admin panel (/admin -> Change Admin Password);
# the env var is then ignored and no redeploy is needed.
#
# Generate a strong one with:
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
# Short or default passwords are accepted but reported by /api/health.
# ADMIN_PASSWORD=change-me

# Secret used to sign admin session tokens. Strongly recommended in production.
# If missing, the server generates a random one per instance: tokens cannot be
# forged, but sessions are lost whenever the server restarts.
# AUTH_SECRET=change-me-to-a-long-random-string

# --- TEMPORARY: open the admin panel without a password ---
# DO NOT SET THIS ON THE PUBLIC BACKEND. The admin routes include
# DELETE /api/sermons/:id, /api/events/:id and /api/gallery/:id, so anyone
# who finds the API can permanently erase the site's content.
# AUTH_DISABLED=true

# --- Database (REQUIRED in production) ---
# Without this the API writes to a SQLite file inside the function bundle, which
# is read-only and discarded between invocations. Content will not persist.
# Create a database at https://turso.new, then copy the URL it gives you.
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...

# --- Uploads (REQUIRED in production) ---
# Without this the API writes uploads to the function bundle's disk, which is
# read-only and discarded between invocations. Uploads will fail.
# Create a Blob store in the Vercel dashboard: Storage -> Blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# --- Contact form email (required for the contact form to work) ---
# Gmail: enable 2FA and generate an "App Password" at
# https://myaccount.google.com/apppasswords
# EMAIL_USER=church@example.com
# EMAIL_PASS=xxxx xxxx xxxx xxxx
# EMAIL_RECEIVER=inbox@church.com

# --- Local dev only ---
PORT=5000
