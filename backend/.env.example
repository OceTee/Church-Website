# ---------------------------------------------------------------------------
# BACKEND environment. Copy to `backend/.env` for `npm run dev` in the backend.
# In production these are Environment Variables on the backend Vercel project.
# NEVER commit a real .env — it is gitignored.
# ---------------------------------------------------------------------------

# --- CORS (required: the frontend is a different origin) ---
# Exact origin(s) of the frontend, comma-separated. No trailing slash.
ALLOWED_ORIGIN=http://localhost:5173

# --- Admin authentication ---
# The admin password is stored in the database as a scrypt hash. ADMIN_PASSWORD
# is only used ONCE, to create the first admin account on an empty database.
# After that, change it from the admin panel (/admin -> Change Admin Password);
# the env var is then ignored and no redeploy is needed.
#
# Generate a strong one with:
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
# Short or default passwords are accepted but logged, and reported to a
# signed-in admin by /api/health/details (never by the public /api/health).
# ADMIN_PASSWORD=change-me

# Secret used to sign admin session tokens. Strongly recommended in production.
# If missing, the server generates a random one per instance: tokens cannot be
# forged, but sessions are lost whenever the server restarts.
# AUTH_SECRET=change-me-to-a-long-random-string

# --- TEMPORARY: open the admin panel without a password ---
# DO NOT SET THIS ON THE PUBLIC BACKEND. The admin routes include
# DELETE /api/sermons/:id, /api/events/:id and /api/gallery/:id, so anyone
# who finds the API can permanently erase the site's content.
# AUTH_DISABLED=true

# --- Database (REQUIRED in production) ---
# Without this the API writes to a SQLite file inside the function bundle, which
# is read-only and discarded between invocations. Content will not persist.
# Create a database at https://turso.new, then copy the URL it gives you.
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...

# --- Uploads (REQUIRED in production) ---
# Without this the API writes uploads to the function bundle's disk, which is
# read-only and discarded between invocations. Uploads will fail.
# Create a Blob store in the Vercel dashboard: Storage -> Blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Gallery uploads check total Blob bytes before upload and prune oldest gallery
# photos when the incoming photo would take usage above 85% of this ceiling.
# Defaults to 1 GB (the Hobby included storage allowance); set this to the
# project's intended storage ceiling in bytes on other plans.
# BLOB_STORAGE_LIMIT_BYTES=1000000000

# Turso plan storage is shared across the databases in the account. The
# gallery pre-upload check estimates this database's live SQLite pages and
# removes oldest gallery photos if usage would exceed 85% of this budget.
# Defaults to the current Free plan's 5 GB storage allowance; set a practical
# per-database share here if the project uses a different plan or other DBs.
# TURSO_STORAGE_LIMIT_BYTES=5368709120

# --- Contact form email -----------------------------------------------------
# The /api/contact endpoint sends through a Gmail account using an App
# Password. Until EMAIL_USER and EMAIL_PASS are set, /api/contact returns 503
# and the visitor is told to email directly. Nothing is ever silently dropped.
#
# To get an App Password (this account must have 2FA switched on first):
#   1. Turn on 2-Step Verification at
#      https://myaccount.google.com/security
#   2. Open https://myaccount.google.com/apppasswords
#   3. Pick "Mail" as the app and give it any name
#   4. Google shows a 16-character password in four groups of four
#
# EMAIL_PASS must be that 16-character code, NOT the account password. Spaces
# are stripped automatically, so pasting it as "abcd efgh ijkl mnop" is fine.
#
# EMAIL_USER     the Gmail address that sends the message
# EMAIL_PASS     the 16-character App Password from step 4
# EMAIL_RECEIVER where enquiries should land; defaults to EMAIL_USER
#
# Leave these commented out until you have the values. Do not commit a filled-in
# copy of this file: backend/.env is gitignored, this example file is not.
#
# The same three names must be added to the church-website-api Vercel project
# (Settings -> Environment Variables) and the project redeployed, otherwise
# production keeps returning 503.
#
# EMAIL_USER=your-church-address@gmail.com
# EMAIL_PASS=abcd efgh ijkl mnop
# EMAIL_RECEIVER=where-enquiries-should-land@gmail.com

# --- Telegram (gallery photos and sermon audio) -----------------------------
# The Gallery page shows photos from the media channel, read from Telegram's
# public preview; that needs nothing set here. The Sermons page lists the
# audio posts of the messages channel and streams them on the site, which
# needs a bot. Until all three values below are set, each audio item links to
# its Telegram post instead of playing here.
#
#   1. In Telegram, message @BotFather, send /newbot and copy the token.
#   2. Add that bot to the messages channel as an administrator (it needs no
#      permissions ticked; being a member lets it read the posts).
#   3. Sign in at https://my.telegram.org -> "API development tools" and
#      create an app (any name). Copy its api_id and api_hash.
#
# The audio is fetched over MTProto (the protocol the Telegram apps use), not
# the Bot HTTP API, so files over 20 MB stream fine. The bot's login session
# is saved in the database (app_meta) so cold starts do not log in again.
#
# TELEGRAM_API_ID=1234567
# TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# TELEGRAM_BOT_TOKEN=123456789:AA...
#
# Channel usernames; these defaults are the church's channels.
# TELEGRAM_AUDIO_CHANNEL=PossibilityAssemblyNation
# TELEGRAM_GALLERY_CHANNEL=PossibilityAssemblyMedia

# --- Sermon transcription (GitHub Actions) ----------------------------------
# The dashboard's "Transcribe" button starts .github/workflows/transcribe.yml,
# which runs Whisper on GitHub's free runners and sends the text back to
# POST /api/transcriptions/:id/report as a draft. Until both values below are
# set, the dashboard says transcription is not set up.
#
# GITHUB_DISPATCH_TOKEN: a fine-grained personal access token created at
#   https://github.com/settings/personal-access-tokens/new with
#   Repository access -> Only select repositories -> this repository, and
#   Permissions -> Actions -> Read and write. Nothing else.
# TRANSCRIBE_CALLBACK_SECRET: any long random string. The SAME value must be
#   saved as a repository secret of that name (GitHub repository -> Settings ->
#   Secrets and variables -> Actions -> New repository secret). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# GITHUB_DISPATCH_TOKEN=github_pat_...
# TRANSCRIBE_CALLBACK_SECRET=...
#
# Optional overrides:
# GITHUB_REPOSITORY_SLUG=OceTee/Church-Website
# GITHUB_DISPATCH_REF=main

# --- Local dev only ---
PORT=5000
