# ---------------------------------------------------------------------------
# Local development only. Copy to `.env` for `npm run dev`.
# NEVER commit a real `.env` — it is gitignored. Add the production values as
# Environment Variables in the Vercel project settings instead.
# ---------------------------------------------------------------------------

# --- Admin authentication (required in production) ---
# Secret used to sign admin session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Password required to sign in at /admin/login.
# There is NO safe default in production: the server refuses to start without it.
ADMIN_PASSWORD=change-me

# --- Database (required in production) ---
# Remote libSQL/Turso connection. Leave TURSO_DATABASE_URL blank locally and the
# API falls back to server/database.sqlite.
# Create a database at https://turso.new, then copy the URL it gives you.
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...

# --- Uploads (required in production) ---
# Vercel Blob token. When this is set the API stores uploads in Vercel Blob and
# the browser uploads large files directly. When it is absent, uploads are
# written to public/uploads locally.
# Create a Blob store at https://vercel.com/dashboard -> Storage -> Blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# --- Contact form email (required for the contact form to work) ---
# Gmail: enable 2FA and generate an "App Password" at
# https://myaccount.google.com/apppasswords
# EMAIL_USER=church@example.com
# EMAIL_PASS=xxxx xxxx xxxx xxxx
# EMAIL_RECEIVER=inbox@church.com

# --- Local dev only ---
# Port the Express API listens on (default: 5000).
PORT=5000

# Set this to the frontend origin only when the API is hosted separately.
# ALLOWED_ORIGIN=http://localhost:5173

# Frontend build-time overrides (optional). When the frontend and API are
# served from the same origin on Vercel these can be left blank.
# VITE_API_URL=/api
# VITE_ASSET_URL=
