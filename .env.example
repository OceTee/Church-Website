# Copy these into your environment (or a local .env loaded by your process manager)
# before deploying. Both have safe development defaults, but they MUST be set
# to real values in production.

# Shared secret used to sign admin session tokens.
AUTH_SECRET=change-me-to-a-long-random-string

# Password required to sign in at /admin/login.
ADMIN_PASSWORD=admin123

# Port the Express API listens on (default: 5000).
PORT=5000

# Frontend build-time overrides (optional). When the frontend and API are
# served from the same origin these can be left blank.
# VITE_API_URL=/api
# VITE_ASSET_URL=

