{
  "name": "church-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Monorepo root: orchestrates the two independently deployable apps.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm --prefix backend install && npm --prefix frontend install",
    "dev": "concurrently -n api,web -c magenta,cyan \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:set-password": "npm --prefix backend run db:set-password",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deploy:backend": "vercel link --project church-website-api --yes && vercel deploy --prod --yes",
    "deploy:frontend": "vercel link --project church-website-web --yes && vercel deploy --prod --yes"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0"
  }
}
