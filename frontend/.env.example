# ---------------------------------------------------------------------------
# FRONTEND environment. Copy to `frontend/.env` for `npm run dev`.
# In production these are Environment Variables on the frontend Vercel project.
#
# Vite inlines VITE_* variables at BUILD time, so changing one requires a
# rebuild (a redeploy), not just a restart.
# ---------------------------------------------------------------------------

# Base URL of the backend API, including the /api prefix.
# Local:  the backend dev server on :5000
# Prod:   https://<backend-project>.vercel.app/api
VITE_API_URL=http://localhost:5000/api

# Base URL for media files (uploaded images, flyers, sermon audio).
# Only needed when the API stores uploads somewhere other than its own origin.
# Leave blank when the backend serves its own uploads.
VITE_ASSET_URL=
